{
  "manifest_version": 3,
  "name": "AI Broadcaster",
  "version": "1.5.3",
  "description": "Run named workspaces that broadcast prompts and images to free-tier AI chats.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "browsingData",
    "tabs",
    "webNavigation",
    "storage",
    "nativeMessaging",
    "clipboardRead",
    "offscreen"
  ],
  "commands": {
    "grab-to-composer": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Paste clipboard (image/text) into the AI Broadcaster composer"
    },
    "grab-and-broadcast": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Paste clipboard (image/text) into AI Broadcaster AND broadcast now"
    }
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.qwenlm.ai/*",
    "https://chat.mistral.ai/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://kimi.ai/*",
    "https://www.kimi.ai/*",
    "https://kimi.moonshot.cn/*",
    "https://huggingface.co/*",
    "https://duck.ai/*",
    "https://you.com/*",
    "https://www.you.com/*",
    "https://venice.ai/*",
    "https://www.venice.ai/*",
    "https://chat.venice.ai/*",
    "https://poe.com/*",
    "https://www.blackbox.ai/*",
    "https://blackbox.ai/*",
    "https://app.blackbox.ai/*",
    "https://arena.ai/*",
    "https://lmarena.ai/*",
    "https://aistudio.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Broadcaster",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ai_frame_rules",
        "enabled": true,
        "path": "rules/ai_frame_rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data:; frame-src https:;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://chat.mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://huggingface.co/*",
        "https://duck.ai/*",
        "https://you.com/*",
        "https://www.you.com/*",
        "https://venice.ai/*",
        "https://www.venice.ai/*",
        "https://chat.venice.ai/*",
        "https://poe.com/*",
        "https://www.blackbox.ai/*",
        "https://blackbox.ai/*",
        "https://app.blackbox.ai/*",
        "https://arena.ai/*",
        "https://lmarena.ai/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["frame-bypass.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://chat.mistral.ai/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://huggingface.co/*",
        "https://duck.ai/*",
        "https://you.com/*",
        "https://www.you.com/*",
        "https://venice.ai/*",
        "https://www.venice.ai/*",
        "https://chat.venice.ai/*",
        "https://poe.com/*",
        "https://www.blackbox.ai/*",
        "https://blackbox.ai/*",
        "https://app.blackbox.ai/*",
        "https://arena.ai/*",
        "https://lmarena.ai/*",
        "https://aistudio.google.com/*"
      ],
      "js": ["delivery-protocol.js", "providers.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["grab.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
